# Web Push (see src/lib/vapid.ts) — needed only for the "notify me even
# when the app is closed" high-UV alert. Generate your own pair, don't
# reuse an example one:
#
#   npx web-push generate-vapid-keys
#
# The private key never goes to the client — keep it out of NEXT_PUBLIC_*.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach you at if something's wrong with
# your usage — required by the Web Push protocol, shown to no one else.
VAPID_SUBJECT=mailto:you@example.com
# Same value as VAPID_PUBLIC_KEY — duplicated under NEXT_PUBLIC_ so the
# client bundle can read it at build time (see the note in vapid.ts).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Where the push-subscriptions SQLite file lives. Defaults to ./data/push.sqlite
# if unset — override for deployments where the working directory isn't
# writable or isn't persisted across restarts.
# PUSH_DB_PATH=./data/push.sqlite
